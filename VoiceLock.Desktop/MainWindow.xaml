<Window x:Class="VoiceLock.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VoiceLock.Desktop" Title="VoiceLock · Native C++" Width="1440" Height="880" MinWidth="1100" MinHeight="720" Background="#0C1112" Foreground="#EDF2F3" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border BorderBrush="#252E30" BorderThickness="0,0,1,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="26,30,18,30"><StackPanel Orientation="Horizontal"><Viewbox Width="32" Height="36" Margin="0,0,12,0"><Canvas Width="36" Height="40"><Path Stroke="#79E7BF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,18 L3,22 M9,12 L9,28 M15,5 L15,35 M21,9 L21,31 M27,15 L27,25 M33,18 L33,22"/></Canvas></Viewbox><TextBlock Text="VOICELOCK" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Your voice. A quieter channel." FontSize="11" Foreground="#86959E" Margin="0,8,0,0"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="28,20"><TextBlock Text="NATIVE C++  /  CPU" Foreground="#74848D" FontSize="11"/><TextBlock Text="v1.0.0" Foreground="#74848D" FontSize="11" Margin="0,7,0,0"/></StackPanel><StackPanel>
<RadioButton x:Name="NavMicrophone" GroupName="Navigation" Style="{StaticResource Nav}" Content="♩    Microphone" Tag="Microphone" Checked="Navigate_Click"/>
<RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Content="⇄    Audio Routes" Tag="Audio Routes" Checked="Navigate_Click"/>
<RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Content="≋    Noise Control" Tag="Noise Control" Checked="Navigate_Click"/>
<RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Content="☷    Presets" Tag="Presets" Checked="Navigate_Click"/>
<RadioButton x:Name="NavSetup" GroupName="Navigation" Style="{StaticResource Nav}" Content="＋    Voice Setup" Tag="Voice Setup" Checked="Navigate_Click"/>
<RadioButton x:Name="NavAdvanced" GroupName="Navigation" Style="{StaticResource Nav}" Content="⚙    Advanced" Tag="Advanced" Checked="Navigate_Click"/>
</StackPanel></DockPanel></Border>
<Grid Grid.Column="1" Margin="22,22,22,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="12,0,4,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Background="#192E28" CornerRadius="16" Width="64" Height="64" Margin="0,0,20,0"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#7CEAC4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Microphone" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Make your voice clear. Remove background noise in real time." Foreground="#A5B2BA" Margin="0,6,0,0"/></StackPanel></StackPanel><Button Grid.Column="1" Content="⚙" FontSize="22" Width="48" Margin="12,6,0,6" ToolTip="Advanced settings" Click="OpenAdvanced_Click"/></Grid>
<ScrollViewer x:Name="DashboardScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
<Border x:Name="RouteCard" Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Input Device" FontWeight="SemiBold"/><ComboBox x:Name="InputDevice" DisplayMemberPath="Name"/><TextBlock Text="Output / Processed Playback" Margin="0,5,0,0" FontWeight="SemiBold"/><ComboBox x:Name="OutputDevice" DisplayMemberPath="Name"/>
<WrapPanel Margin="0,2,0,12"><Button Content="↻  Refresh Devices" Click="Refresh_Click" FontSize="12"/><Button x:Name="InstallCableButton" Content="Install VB-CABLE" Click="InstallCable_Click" FontSize="12"/><Button Content="↗  VB-CABLE Website" Click="CableWebsite_Click" FontSize="12"/></WrapPanel>
<Border Background="#192C22" CornerRadius="10" Padding="15"><StackPanel><TextBlock x:Name="CableStatus" Text="Checking VB-CABLE…" Foreground="#92EDC2" FontWeight="SemiBold"/><TextBlock Text="After installing: restart Windows and refresh devices." Foreground="#A2CBB8" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
<TextBlock Text="In Discord, games or OBS, use CABLE Output as your microphone." Foreground="#879A9F" FontSize="12" Margin="2,12,0,0"/>
</StackPanel></Border>
<Border x:Name="NoiseCard" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="▥  Noise Suppression" FontWeight="SemiBold" Margin="0,0,0,22"/><TextBlock Text="Suppression Model" Foreground="#B7C3C8"/><ComboBox x:Name="Model"><ComboBoxItem Content="int8-full"/><ComboBoxItem Content="int8"/></ComboBox><TextBlock Text="Performance Profile" Foreground="#B7C3C8"/><ComboBox x:Name="Profile" SelectionChanged="Profile_Changed"><ComboBoxItem Content="Manual"/><ComboBoxItem Content="Maximum Isolation"/><ComboBoxItem Content="Gaming Optimized"/><ComboBoxItem Content="Low Latency"/></ComboBox>
<CheckBox x:Name="Gaming" Content="Gaming Mode" Style="{StaticResource Switch}"/><TextBlock Text="Lower monitoring frequency during play." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/><Button Content="Adjust output gain  →" Click="OpenAdvanced_Click" HorizontalAlignment="Left" FontSize="12"/><TextBlock Text="Calibrate in Presets to unlock measured profiles." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,18"><Border DockPanel.Dock="Right" Background="#23362C" CornerRadius="7" Padding="7,4"><TextBlock x:Name="LiveState" Text="IDLE" FontSize="10" Foreground="#9DE6B9"/></Border><TextBlock Text="Live Preview" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#192022" CornerRadius="10" Padding="8,12" Margin="0,0,6,0"><StackPanel><TextBlock Text="Input" HorizontalAlignment="Center" FontSize="12" Foreground="#B9C6CB"/><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center" Margin="0,14"/><local:LevelMeter x:Name="InputMeter" Width="24" Height="115" AutomationProperties.Name="Microphone input level"/></StackPanel></Border><Border Grid.Column="1" Background="#192022" CornerRadius="10" Padding="8,12"><StackPanel><TextBlock Text="Isolated" HorizontalAlignment="Center" FontSize="12" Foreground="#B9C6CB"/><TextBlock Text="≋" FontSize="24" HorizontalAlignment="Center" Margin="0,10"/><local:LevelMeter x:Name="OutputMeter" Width="24" Height="115" AutomationProperties.Name="Isolated output level"/></StackPanel></Border></Grid>
<Button x:Name="StartButton" Content="▶   Start Isolation" Background="#79E3BE" Foreground="#08231B" FontWeight="SemiBold" Margin="0,18,0,5" Padding="10,15" Click="Start_Click"/><Button Content="■   Stop / Mute" Margin="0,5,0,0" Click="Stop_Click" Padding="10,13"/>
</StackPanel></Border></Grid>
<Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="▥  Real-time Performance" FontWeight="SemiBold" Margin="0,0,0,18"/><UniformGrid Columns="6"><StackPanel Margin="8,0"><TextBlock Text="Latency (estimate)" Style="{StaticResource Caption}"/><TextBlock x:Name="LatencyValue" Text="—" Style="{StaticResource Value}"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="Inference (avg / p95)" Style="{StaticResource Caption}"/><TextBlock x:Name="InferenceValue" Text="—" Style="{StaticResource Value}"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="Sample Rate" Style="{StaticResource Caption}"/><TextBlock x:Name="RateValue" Text="—" Style="{StaticResource Value}"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="CPU Usage" Style="{StaticResource Caption}"/><TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource Value}"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="RAM Usage" Style="{StaticResource Caption}"/><TextBlock x:Name="RamValue" Text="—" Style="{StaticResource Value}"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="RTF (p95)" Style="{StaticResource Caption}"/><TextBlock x:Name="RtfValue" Text="—" Style="{StaticResource Value}"/></StackPanel></UniformGrid></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,12"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Clear" FontSize="11" Padding="10,5" Click="ClearLog_Click"/><TextBlock Text="›_   Console / Live Status" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="Metrics" Text="Waiting for audio. Start isolation to see live measurements." Foreground="#96EBB5" FontFamily="Consolas" FontSize="12" Margin="0,10,0,0" LineHeight="19"/></StackPanel></Border>
</StackPanel></ScrollViewer>
<Border x:Name="SetupPanel" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
<TextBlock Text="01  GET THE MODELS" FontSize="17" FontWeight="SemiBold"/>
<TextBlock Text="Download both official quantized models once. Files are pinned to an upstream revision and verified against the repository SHA-256 hashes. Inference then works offline." Margin="0,10,0,10" Foreground="#94A3B8"/>
<Button Content="Download / verify models" Click="Setup_Click" HorizontalAlignment="Left"/>
<TextBlock Text="02  ENROLL YOUR VOICE" FontSize="17" FontWeight="SemiBold" Margin="0,25,0,10"/>
<TextBlock Text="Select your physical microphone on the Microphone tab. In a quiet room, say: ‘This is my voice. Keep my words clear while I speak.’ Speak for three seconds after clicking Record." Foreground="#94A3B8"/>
<CheckBox x:Name="Consent" Content="I agree to store my voice reference locally on this PC."/>
<StackPanel Orientation="Horizontal"><Button Content="Record 3 seconds" Click="Enroll_Click"/><Button Content="Delete voice reference" Click="Forget_Click"/></StackPanel>
<TextBlock x:Name="EnrollmentStatus" Margin="0,8,0,0"/>
<TextBlock Text="03  CALIBRATE THIS LAPTOP" FontSize="17" FontWeight="SemiBold" Margin="0,25,0,10"/>
<TextBlock Text="Tests 16 combinations: both models, 40/80 ms chunks and 1–4 CPU threads. This repeated-reference workload measures throughput, not gaming FPS or separation quality. Allow a few minutes." Foreground="#94A3B8"/>
<Button Content="Run CPU calibration" Click="Calibrate_Click" HorizontalAlignment="Left"/>
<TextBlock x:Name="CalibrationStatus" Margin="0,8,0,0"/>
<TextBlock x:Name="Hardware" FontFamily="Consolas" Margin="0,20,0,0"/>
</StackPanel></ScrollViewer></Border>
<Border x:Name="AdvancedPanel" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
<TextBlock Text="CPU inference threads (1–4)"/><TextBox x:Name="Threads" Text="2"/>
<TextBlock Text="Inference chunk duration (40 or 80 ms)"/><TextBox x:Name="Chunk" Text="80"/>
<TextBlock Text="Input device sample rate"/><TextBox x:Name="InputRate" Text="48000"/>
<TextBlock Text="Output device sample rate"/><TextBox x:Name="OutputRate" Text="48000"/>
<TextBlock Text="Playback cushion (40, 80 or 120 ms; larger tolerates more jitter)"/><TextBox x:Name="OutputBuffer" Text="80"/>
<TextBlock Text="Output gain (0–2; peak limiter at 0.98)"/><TextBox x:Name="Gain" Text="1"/>
<CheckBox x:Name="Diagnostics" Content="Diagnostic log · disabled during Gaming Mode or overload"/>
<Button Content="Save settings and stop audio" Click="Save_Click" HorizontalAlignment="Left"/>
<TextBlock Text="Changing configuration stops and mutes the pipeline. Start again to create fresh model and resampler state. A 40 ms override is experimental until calibration passes. Device disconnection requires reconnection, Refresh devices and Start." Foreground="#94A3B8" Margin="0,16,0,16"/>
<TextBlock Text="Closing exits and mutes. Minimizing keeps isolation running in the system tray. Right-click the tray icon to mute or exit." Foreground="#94A3B8"/>
</StackPanel></ScrollViewer></Border>
<Border Grid.Row="2" Background="#141E1C" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="Connecting to local audio worker…" Foreground="#A9C7BC" FontSize="12"/></Border>
</Grid></Grid></Window>